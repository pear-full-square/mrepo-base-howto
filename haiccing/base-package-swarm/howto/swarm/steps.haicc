# swarm: a swarm on a host, its master, two nodes registered.
# The scene: a host deployed and in service, at host.
# step: the swarm made, with its master and its lookup db
host swarm/create swarms/swarm-1
# expect: "created":"swarms/swarm-1","swarm":"swarm-1","master":"swarm-1/master"
# step: a node deployed, in service, registered
host swarm/deploy swarms/swarm-1/node-1
# expect: "deployed":"swarms/swarm-1/node-1","mrepo":"swarm-1/node-1"
# step: a second node
host swarm/deploy swarms/swarm-1/node-2
# expect: "registered":"swarm-1/master"
# step: who is registered, as the master has it
host swarm/status swarms/swarm-1
# expect: "uri":"swarm-1/node-2","role":"node"
# step: the swarm's node, its kind and where its lookup db is
host crud/read swarms/swarm-1
# expect: "kind":"swarm","master":"master"
# step: a node taken out again
host swarm/leave swarms/swarm-1/node-2
# expect: "left":"swarms/swarm-1/node-2","mrepo":"swarm-1/node-2"
