# logs: a swarm's logs read at its master.
# The scene: the swarm package's how-to swarm, at its end.
# step: something for a node to log
host/swarms/swarm-1/node-1 crud/create notes/a
# expect: "outcome":"created"
# step: its log synced to the master now
host/swarms/swarm-1/node-1 log/status . sync
# expect: "role":"node","master":"swarm-1/master"
# step: every node's log, in one view
host/swarms/swarm-1/master log/read
# expect: "node":"swarm-1/node-1"
# step: one node's, its last five records
host/swarms/swarm-1/master log/read . swarm-1/node-1 5
# expect: "command":"crud/create notes/a","ok":true
# step: a node's own log, at the node
host/swarms/swarm-1/node-1 log/read
# expect: "nodes":[{"uri":"swarm-1/node-1"
# step: what the master collected
host/swarms/swarm-1/master log/status
# expect: "collected":[{"uri":"swarm-1/node-1"
