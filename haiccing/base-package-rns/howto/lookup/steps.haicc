# lookup: who is in a swarm, who is active, where a node lives.
# The scene: the swarm package's how-to swarm, at its end.
# step: who is registered and active, asked of a node
host/swarms/swarm-1/node-1 rns/status
# expect: "uri":"swarm-1/node-2","role":"node","state":"active"
# step: the same, asked of the master
host/swarms/swarm-1/master rns/status
# expect: "role":"master","master":"swarm-1/master"
# step: where a node lives
host/swarms/swarm-1/node-1 rns/resolve . swarm-1/node-2
# expect: "uri":"swarm-1/node-2","role":"node"
# step: a node stopped goes quiet once its lease ran out
host/swarms/swarm-1/node-2 service/stop
# expect: "service":"stopped"
# step: started again, active again
host/swarms/swarm-1/node-2 service/start
# expect: "service":"started"
