{
  "type": "record",
  "name": "haiccing.basePackageRns.lookupEntry",
  "doc": "An entry of a swarm's lookup db, a record of the topic its master writes: a node registered, turned active or quiet, or taken out",
  "fields": [
    {
      "name": "op",
      "type": "string",
      "doc": "what the entry says: register, active, quiet or leave"
    },
    {
      "name": "uri",
      "type": "string",
      "doc": "the node's unique URI"
    },
    {
      "name": "role",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "register: master or node"
    },
    {
      "name": "key",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "register: the node's public key, hex"
    },
    {
      "name": "where",
      "type": [
        "null",
        {
          "type": "record",
          "name": "haiccing.basePackageRns.where",
          "doc": "Where a node lives",
          "fields": [
            {
              "name": "machine",
              "type": "string",
              "doc": "its machine's name"
            },
            {
              "name": "folder",
              "type": "string",
              "doc": "its folder there"
            }
          ]
        }
      ],
      "default": null,
      "doc": "register: where the node lives"
    },
    {
      "name": "by",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "register: the unique URI of the mrepo that created the node and registered it"
    },
    {
      "name": "since",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "quiet: when its lease ran out, an ISO 8601 time"
    }
  ]
}
